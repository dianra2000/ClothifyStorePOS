<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clothify.controller.ReportController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Header -->
    <Label text="Reports" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <Separator />

    <!-- Report Options -->
    <TitledPane text="Generate Report" expanded="true">
        <GridPane hgap="15" vgap="15">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>

            <columnConstraints>
                <ColumnConstraints minWidth="120" />
                <ColumnConstraints minWidth="200" hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Report Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <ComboBox fx:id="reportTypeCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity" />

            <Label text="Start Date:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <DatePicker fx:id="startDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity" />

            <Label text="End Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <DatePicker fx:id="endDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity" />
        </GridPane>
    </TitledPane>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="📊 Generate Report" onAction="#handleGenerateReport"
                style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16;" />
        <Button text="🖨 Print" onAction="#handlePrintReport"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 16;" />
        <Button text="📄 Export PDF" onAction="#handleExportPDF"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 16;" />
    </HBox>

    <Separator />

    <!-- Placeholder message -->
    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" spacing="10">
        <Label text="📊" style="-fx-font-size: 48px;" />
        <Label text="Select a report type and date range, then click Generate Report."
               style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;" wrapText="true" />
    </VBox>

</VBox>
