<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clothify.controller.CustomerController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Title -->
    <Label text="Customer Management" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <!-- Search Section -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Search:" />
        <TextField fx:id="searchField" promptText="Search by name, phone or email..." HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Customer Table -->
    <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode" text="Code" prefWidth="100" />
            <TableColumn fx:id="colName" text="Name" prefWidth="150" />
            <TableColumn fx:id="colPhone" text="Phone" prefWidth="120" />
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200" />
            <TableColumn fx:id="colPoints" text="Loyalty Points" prefWidth="100" />
        </columns>
    </TableView>

    <!-- Customer Form -->
    <TitledBox text="Customer Details">
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="100" />
                <ColumnConstraints minWidth="200" />
                <ColumnConstraints minWidth="100" />
                <ColumnConstraints minWidth="200" />
            </columnConstraints>

            <!-- Row 1 -->
            <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Last Name:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
            <TextField fx:id="lastNameField" GridPane.rowIndex="0" GridPane.columnIndex="3" />

            <!-- Row 2 -->
            <Label text="Phone:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="phoneField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
            <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="3" />

            <!-- Row 3 -->
            <Label text="Address:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextArea fx:id="addressArea" GridPane.rowIndex="2" GridPane.columnIndex="1"
                      GridPane.columnSpan="3" prefRowCount="3" />

            <!-- Row 4 -->
            <Label text="Loyalty Points:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <TextField fx:id="loyaltyPointsField" GridPane.rowIndex="3" GridPane.columnIndex="1" editable="false" />
        </GridPane>
    </TitledBox>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="addButton" text="Add" onAction="#handleAdd"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
        <Button fx:id="updateButton" text="Update" onAction="#handleUpdate"
                style="-fx-background-color: #f39c12; -fx-text-fill: white;" />
        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
        <Button fx:id="clearButton" text="Clear" onAction="#handleClear"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white;" />
    </HBox>

</VBox>