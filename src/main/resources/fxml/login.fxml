<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="860.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.clothify.controller.LoginController">

    <children>

        <!-- Left Banner Panel -->
        <VBox prefWidth="440" prefHeight="520"
              AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.bottomAnchor="0"
              style="-fx-background-color: linear-gradient(to bottom right, #1e3a5f, #0f172a);"
              alignment="CENTER" spacing="20">

            <!-- Banner Image -->
            <ImageView fitWidth="440" fitHeight="260" preserveRatio="false">
                <image>
                    <Image url="@../images/banner.png" />
                </image>
            </ImageView>

            <Label text="Clothify Store" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Premium Fashion · Point of Sale System"
                   style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;" />

            <!-- Decorative line -->
            <HBox alignment="CENTER" spacing="8" maxWidth="300">
                <Label text="────────" style="-fx-text-fill: #f59e0b;" />
                <Label text="*" style="-fx-text-fill: #f59e0b; -fx-font-size: 16px; -fx-font-weight: bold;" />
                <Label text="────────" style="-fx-text-fill: #f59e0b;" />
            </HBox>

            <Label text="Your trusted retail management solution"
                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
        </VBox>

        <!-- Right Login Panel -->
        <VBox prefWidth="420" prefHeight="520"
              AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
              AnchorPane.bottomAnchor="0"
              style="-fx-background-color: white;"
              alignment="CENTER" spacing="18">
            <padding>
                <Insets left="50" right="50" />
            </padding>

            <!-- Logo + Title -->
            <ImageView fitWidth="64" fitHeight="64" preserveRatio="true">
                <image>
                    <Image url="@../images/logo.png" />
                </image>
            </ImageView>

            <Label text="Welcome Back" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
            <Label text="Sign in to your account" style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />

            <!-- Divider -->
            <Separator prefWidth="320" />

            <!-- Username -->
            <VBox spacing="6" fillWidth="true">
                <Label text="Username" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" />
                <TextField fx:id="usernameField" promptText="Enter username"
                           style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-radius: 8;
                                  -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-padding: 10 14;
                                  -fx-font-size: 13px;" />
            </VBox>

            <!-- Password -->
            <VBox spacing="6" fillWidth="true">
                <Label text="Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" />
                <PasswordField fx:id="passwordField" promptText="Enter password"
                               style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-radius: 8;
                                      -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-padding: 10 14;
                                      -fx-font-size: 13px;" />
            </VBox>

            <!-- Error Message -->
            <Label fx:id="messageLabel" textFill="#ef4444" wrapText="true"
                   style="-fx-font-size: 12px;" />

            <!-- Login Button -->
            <Button fx:id="loginButton" defaultButton="true"
                    text="Sign In →" onAction="#handleLogin"
                    prefWidth="320" prefHeight="44"
                    style="-fx-background-color: linear-gradient(to right, #1e3a5f, #2563eb);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;
                           -fx-background-radius: 10; -fx-cursor: hand;" />

            <Separator prefWidth="320" />

            <Label text="© 2025 Clothify Store POS  |  v1.0"
                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
        </VBox>

        <!-- Close Button -->
        <Button layoutX="830" layoutY="10"
                onAction="#handleClose" text="✕"
                style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                       -fx-background-radius: 50; -fx-font-size: 13px; -fx-cursor: hand;
                       -fx-min-width: 28; -fx-min-height: 28;" />

    </children>
</AnchorPane>