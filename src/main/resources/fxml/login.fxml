<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #3498db);"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.clothify.controller.LoginController">

    <children>
        <!-- Login Box -->
        <VBox alignment="CENTER" layoutX="150.0" layoutY="50.0"
              prefHeight="300.0" prefWidth="300.0" spacing="20.0"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);"
              AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="150.0"
              AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="50.0">

            <children>
                <Label text="Clothify Store" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <Label text="Point of Sale System" textFill="#7f8c8d">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <TextField fx:id="usernameField" promptText="Username"
                           style="-fx-background-radius: 5; -fx-border-radius: 5;
                                  -fx-border-color: #bdc3c7; -fx-border-width: 1;">
                    <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                    </VBox.margin>
                </TextField>

                <PasswordField fx:id="passwordField" promptText="Password"
                               style="-fx-background-radius: 5; -fx-border-radius: 5;
                                      -fx-border-color: #bdc3c7; -fx-border-width: 1;">
                    <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                    </VBox.margin>
                </PasswordField>

                <Button fx:id="loginButton" defaultButton="true"
                        mnemonicParsing="false" onAction="#handleLogin"
                        prefWidth="200.0"
                        style="-fx-background-color: #3498db; -fx-background-radius: 5; -fx-text-fill: white;"
                        text="Login">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>

                <Label fx:id="messageLabel" textFill="#e74c3c" />
            </children>
        </VBox>

        <!-- Close Button -->
        <Button layoutX="560.0" layoutY="10.0" mnemonicParsing="false"
                onAction="#handleClose"
                style="-fx-background-color: transparent; -fx-text-fill: white;"
                text="X" textFill="white">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>
    </children>
</AnchorPane>