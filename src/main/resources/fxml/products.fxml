<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clothify.controller.ProductController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Header with Title and Stats -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox>
            <Label text="Product Management" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <Label text="Manage your inventory products" style="-fx-text-fill: #7f8c8d;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lowStockCountLabel" style="-fx-font-weight: bold;" />
    </HBox>

    <Separator />

    <!-- Toolbar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search products..." HBox.hgrow="ALWAYS" />
        <Button text="Refresh" onAction="#handleRefresh"
                style="-fx-background-color: #3498db; -fx-text-fill: white;" />
        <Button text="Export" onAction="#handleExport"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
    </HBox>

    <!-- Product Table -->
    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode" text="Code" prefWidth="100" />
            <TableColumn fx:id="colName" text="Product Name" prefWidth="200" />
            <TableColumn fx:id="colCategory" text="Category" prefWidth="120" />
            <TableColumn fx:id="colPrice" text="Price" prefWidth="100" />
            <TableColumn fx:id="colQuantity" text="Stock" prefWidth="80" />
            <TableColumn fx:id="colStatus" text="Status" prefWidth="100" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- Product Form in TitledPane -->
    <TitledPane text="Product Details" expanded="true">
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>

            <columnConstraints>
                <ColumnConstraints minWidth="100" />
                <ColumnConstraints minWidth="200" />
                <ColumnConstraints minWidth="100" />
                <ColumnConstraints minWidth="200" />
            </columnConstraints>

            <!-- Row 0: Code and Name -->
            <Label text="Product Code:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="productCodeField" editable="false"
                       style="-fx-background-color: #f0f0f0;"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Product Name:*" GridPane.rowIndex="0" GridPane.columnIndex="2" />
            <TextField fx:id="productNameField" promptText="Enter product name"
                       GridPane.rowIndex="0" GridPane.columnIndex="3" />

            <!-- Row 1: Category and Supplier -->
            <Label text="Category:*" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <ComboBox fx:id="categoryCombo" promptText="Select category"
                      GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Supplier:*" GridPane.rowIndex="1" GridPane.columnIndex="2" />
            <ComboBox fx:id="supplierCombo" promptText="Select supplier"
                      GridPane.rowIndex="1" GridPane.columnIndex="3" />

            <!-- Row 2: Size and Color -->
            <Label text="Size:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="sizeField" promptText="e.g., M, L, XL"
                       GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Color:" GridPane.rowIndex="2" GridPane.columnIndex="2" />
            <TextField fx:id="colorField" promptText="e.g., Red, Blue"
                       GridPane.rowIndex="2" GridPane.columnIndex="3" />

            <!-- Row 3: Price and Cost -->
            <Label text="Price:*" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <TextField fx:id="priceField" promptText="0.00"
                       GridPane.rowIndex="3" GridPane.columnIndex="1" />

            <Label text="Cost:" GridPane.rowIndex="3" GridPane.columnIndex="2" />
            <TextField fx:id="costField" promptText="0.00"
                       GridPane.rowIndex="3" GridPane.columnIndex="3" />

            <!-- Row 4: Quantity and Reorder Level -->
            <Label text="Quantity:*" GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <TextField fx:id="quantityField" promptText="0"
                       GridPane.rowIndex="4" GridPane.columnIndex="1" />

            <Label text="Reorder Level:" GridPane.rowIndex="4" GridPane.columnIndex="2" />
            <TextField fx:id="reorderLevelField" promptText="10"
                       GridPane.rowIndex="4" GridPane.columnIndex="3" />

            <!-- Row 5: Description -->
            <Label text="Description:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <TextArea fx:id="descriptionArea" promptText="Product description..."
                      prefRowCount="3" wrapText="true"
                      GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="3" />

            <!-- Row 6: Required fields note -->
            <Label text="* Required fields" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"
                   GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="4" />
        </GridPane>
    </TitledPane>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="addButton" text="Add Product" onAction="#handleAdd"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-min-width: 100px; -fx-min-height: 35px;" />
        <Button fx:id="updateButton" text="Update" onAction="#handleUpdate"
                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-min-width: 100px; -fx-min-height: 35px;" />
        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-min-width: 100px; -fx-min-height: 35px;" />
        <Button fx:id="clearButton" text="Clear" onAction="#handleClear"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-min-width: 100px; -fx-min-height: 35px;" />
    </HBox>

    <!-- Status Bar -->
    <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 5;" alignment="CENTER_LEFT">
        <Label text="Total Products: " />
        <Label fx:id="totalProductsLabel" text="0" style="-fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Last Updated: " />
        <Label fx:id="lastUpdatedLabel" text="Just now" />
    </HBox>

</VBox>