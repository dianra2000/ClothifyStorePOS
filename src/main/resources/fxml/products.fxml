<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.clothify.controller.ProductController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Header -->
    <Label text="Product Management" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <!-- Search -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Search:" />
        <TextField fx:id="searchField" promptText="Search products..." HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Product Table -->
    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode" text="Code" prefWidth="100" />
            <TableColumn fx:id="colName" text="Product Name" prefWidth="200" />
            <TableColumn fx:id="colCategory" text="Category" prefWidth="120" />
            <TableColumn fx:id="colPrice" text="Price" prefWidth="100" />
            <TableColumn fx:id="colQuantity" text="Stock" prefWidth="80" />
        </columns>
    </TableView>

    <!-- Product Form -->
    <TitledPane text="Product Details" expanded="true">
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>

            <columnConstraints>
                <ColumnConstraints minWidth="100" />
                <ColumnConstraints minWidth="200" />
                <ColumnConstraints minWidth="100" />
                <ColumnConstraints minWidth="200" />
            </columnConstraints>

            <Label text="Product Code:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="productCodeField" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Product Name:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
            <TextField fx:id="productNameField" GridPane.rowIndex="0" GridPane.columnIndex="3" />

            <Label text="Category:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <ComboBox fx:id="categoryCombo" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Supplier:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
            <ComboBox fx:id="supplierCombo" GridPane.rowIndex="1" GridPane.columnIndex="3" />

            <Label text="Price:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="priceField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Quantity:" GridPane.rowIndex="2" GridPane.columnIndex="2" />
            <TextField fx:id="quantityField" GridPane.rowIndex="2" GridPane.columnIndex="3" />
        </GridPane>
    </TitledPane>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="addButton" text="Add" onAction="#handleAdd"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
        <Button fx:id="updateButton" text="Update" onAction="#handleUpdate"
                style="-fx-background-color: #f39c12; -fx-text-fill: white;" />
        <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
        <Button fx:id="clearButton" text="Clear" onAction="#handleClear"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white;" />
    </HBox>
</VBox>