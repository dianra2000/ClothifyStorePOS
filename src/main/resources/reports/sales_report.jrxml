              uuid="4a1e2d3c-5b6f-7e8d-9a0b-1c2d3e4f5g6h">

    <!-- ==================== PARAMETERS ==================== -->
    <parameter name="startDate" class="java.sql.Date">
        <parameterDescription><![CDATA[Start date for report]]></parameterDescription>
        <defaultValueExpression><![CDATA[new java.sql.Date(System.currentTimeMillis() - 30L * 24 * 60 * 60 * 1000)]]></defaultValueExpression>
    </parameter>

    <parameter name="endDate" class="java.sql.Date">
        <parameterDescription><![CDATA[End date for report]]></parameterDescription>
        <defaultValueExpression><![CDATA[new java.sql.Date(System.currentTimeMillis())]]></defaultValueExpression>
    </parameter>

    <parameter name="reportTitle" class="java.lang.String">
        <defaultValueExpression><![CDATA["Sales Report"]]></defaultValueExpression>
    </parameter>

    <parameter name="companyName" class="java.lang.String">
        <defaultValueExpression><![CDATA["Clothify Store"]]></defaultValueExpression>
    </parameter>

    <parameter name="companyLogo" class="java.lang.String">
        <defaultValueExpression><![CDATA["/images/logo.png"]]></defaultValueExpression>
    </parameter>

    <!-- ==================== QUERY STRING ==================== -->
    <queryString>
        <![CDATA[
            SELECT 
                o.order_id,
                o.order_number,
                o.order_date,
                o.subtotal,
                o.tax,
                o.discount,
                o.total,
                o.payment_method,
                o.payment_status,
                c.customer_id,
                c.first_name,
                c.last_name,
                c.phone,
                c.email,
                u.user_id,
                u.full_name as cashier_name,
                COUNT(DISTINCT oi.order_item_id) as total_items,
                SUM(oi.quantity) as total_quantity
            FROM orders o
            INNER JOIN customers c ON o.customer_id = c.customer_id
            INNER JOIN users u ON o.user_id = u.user_id
            LEFT JOIN order_items oi ON o.order_id = oi.order_id
            WHERE DATE(o.order_date) BETWEEN $P{startDate} AND $P{endDate}
                AND o.payment_status = 'paid'
            GROUP BY o.order_id
            ORDER BY o.order_date DESC
        ]]>
    </queryString>

    <!-- ==================== FIELDS ==================== -->
    <field name="order_id" class="java.lang.Integer"/>
    <field name="order_number" class="java.lang.String"/>
    <field name="order_date" class="java.sql.Timestamp"/>
    <field name="subtotal" class="java.math.BigDecimal"/>
    <field name="tax" class="java.math.BigDecimal"/>
    <field name="discount" class="java.math.BigDecimal"/>
    <field name="total" class="java.math.BigDecimal"/>
    <field name="payment_method" class="java.lang.String"/>
    <field name="payment_status" class="java.lang.String"/>
    <field name="customer_id" class="java.lang.Integer"/>
    <field name="first_name" class="java.lang.String"/>
    <field name="last_name" class="java.lang.String"/>
    <field name="phone" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="cashier_name" class="java.lang.String"/>
    <field name="total_items" class="java.lang.Long"/>
    <field name="total_quantity" class="java.math.BigDecimal"/>

    <!-- ==================== VARIABLES ==================== -->
    <variable name="customerName" class="java.lang.String">
        <variableExpression><![CDATA[$F{first_name} + " " + $F{last_name}]]></variableExpression>
    </variable>

    <variable name="grandSubtotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
    </variable>

    <variable name="grandTax" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{tax}]]></variableExpression>
    </variable>

    <variable name="grandTotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total}]]></variableExpression>
    </variable>

    <variable name="totalOrders" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{order_id}]]></variableExpression>
    </variable>

